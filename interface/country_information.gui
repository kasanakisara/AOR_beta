guiTypes = {
	containerWindowType = {
		name = "country_information_window"
		size = { width =1000 height = 1000 }
		position = { x = -950 y = -300 }
		Orientation = CENTER
		moveable = yes

		
		buttonType = {
			name ="country_information_button_1" #按钮1
			position = { x = -130 y = -71 }
			quadTextureSprite ="GFX_country_information_button_1" 
			clicksound = click_default
			Orientation = CENTER_UP
			scale = 0.5
		}
		buttonType = {
			name ="country_information_button_2" #按钮2
			position = { x = 75 y = -71 }
			quadTextureSprite ="GFX_country_information_button_2" 
			clicksound = click_default
			Orientation = CENTER_UP
			scale = 0.5
		}
		buttonType = {
			name ="country_information_button_3" #按钮3
			position = { x = 280 y = -71 }
			quadTextureSprite ="GFX_country_information_button_3" 
			clicksound = click_default
			Orientation = CENTER_UP
			scale = 0.5
		}
		buttonType = {
			name ="country_information_button_4" #按钮4
			position = { x = 510 y = -71 }
			quadTextureSprite ="GFX_country_information_button_4" 
			clicksound = click_default
			Orientation = CENTER_UP
			scale = 0.5
		}
		iconType = {
			name ="picture" #图片
			spriteType = "GFX_country_information_picture"
			Orientation = CENTER_UP
			position = { x = 789 y = 49 }
			scale = 1
		}
		iconType = {
			name ="country_information_bg" #背景 
			spriteType = "GFX_country_information_background"
			Orientation = CENTER_UP
		    position = { x = -150 y = 0 }	
			scale = 1
		}

		buttonType = {
			name ="close_button" #关闭按钮
			position = { x = 740 y = -30 }
			quadTextureSprite = "GFX_closebutton" #先凑活使着，重置美工再改
			pdx_tooltip = close_bt_desc
			clicksound = click_close
			shortcut = "ENTER"
			Orientation = CENTER_UP
			scale = 1.3

		}
		containerWindowType = {
			name = "country_information_TEXT_window"
			Orientation = CENTER_UP
			size = { width =1050 height = 710 }
			position = { x = -30 y = 125 }
			clipping = yes
			instantTextBoxType = { 
				name ="country_information_TEXT" #文本框
				font = "fangsong33"
				text = [country_information_TEXT_spcloc]
				scrollbartype = standardtext_slider
				format = left
				maxWidth = 733
				maxHeight = 365
			}
		}
	}
	
}