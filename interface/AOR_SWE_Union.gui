@PARANOIA_PARANOIAMETER_MAIN_X = 20
@PARANOIA_PARANOIAMETER_MAIN_Y = 40
@PARANOIA_TEXT_X = 50 #Needs to be -145(overlapping sword) / -130(evading sword) / -140(bottom) relative to MAIN
@PARANOIA_TEXT_Y = 0 #Needs to be +80(overlapping sword) / +110(bottom) relative to MAIN

guiTypes = { #主体结构
	containerWindowType = {
		name = "AOR_SWE_Union_gui"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 210 }

		iconType = {
			name = "SWE_Union_GUI_progress_bar"
			spriteType = "GFX_Union_GUI_progressbar"
			position = { x=@PARANOIA_PARANOIAMETER_MAIN_X	 y=@PARANOIA_PARANOIAMETER_MAIN_Y }
		}

		instantTextBoxType = {
			name = "AOR_SWE_Union_gui_title"
			position = { x = @PARANOIA_TEXT_X y = @PARANOIA_TEXT_Y }
			font = "hoi_18mbs"
			text = "SWE_Union_title"
			format = center
			maxWidth = 400
		}

		instantTextBoxType = {
			name = "AOR_SWE_Union_gui_num"
			position = { x = 50 y = 100 }
			font = "hoi_18mbs"
			text = "SWE_Union_num"
			format = center
			maxWidth = 400
		}

		instantTextBoxType = {
			name = "AOR_SWE_Union_gui_quote"
			position = { x = 50 y = 140 }
			font = "hoi_18mbs"
			text = "SWE_Union_enable_quote"
			format = center
			maxWidth = 400
		}
	}
}